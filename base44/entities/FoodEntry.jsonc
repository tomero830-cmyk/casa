{
  "name": "FoodEntry",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d0\u05e8\u05d5\u05d7\u05d4"
    },
    "meal_type": {
      "type": "string",
      "enum": [
        "breakfast",
        "lunch",
        "dinner",
        "snack"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d0\u05e8\u05d5\u05d7\u05d4"
    },
    "food_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d6\u05d5\u05df"
    },
    "amount_grams": {
      "type": "number",
      "description": "\u05db\u05de\u05d5\u05ea \u05d1\u05d2\u05e8\u05de\u05d9\u05dd"
    },
    "calories": {
      "type": "number",
      "description": "\u05e7\u05dc\u05d5\u05e8\u05d9\u05d5\u05ea"
    },
    "protein": {
      "type": "number",
      "description": "\u05d7\u05dc\u05d1\u05d5\u05df \u05d1\u05d2\u05e8\u05de\u05d9\u05dd"
    },
    "carbs": {
      "type": "number",
      "description": "\u05e4\u05d7\u05de\u05d9\u05de\u05d5\u05ea \u05d1\u05d2\u05e8\u05de\u05d9\u05dd"
    },
    "fat": {
      "type": "number",
      "description": "\u05e9\u05d5\u05de\u05df \u05d1\u05d2\u05e8\u05de\u05d9\u05dd"
    },
    "photo_url": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05d0\u05d5\u05db\u05dc"
    },
    "ai_analyzed": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e0\u05d5\u05ea\u05d7 \u05e2\u05dc \u05d9\u05d3\u05d9 AI"
    },
    "steps": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e6\u05e2\u05d3\u05d9\u05dd \u05d1\u05d9\u05d5\u05dd"
    }
  },
  "required": [
    "date",
    "meal_type",
    "food_name",
    "calories"
  ]
}