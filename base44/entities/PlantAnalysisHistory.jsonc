{
  "name": "PlantAnalysisHistory",
  "type": "object",
  "properties": {
    "plant_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e6\u05de\u05d7"
    },
    "plant_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e6\u05de\u05d7"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e0\u05d9\u05ea\u05d5\u05d7"
    },
    "health_status": {
      "type": "string",
      "enum": [
        "healthy",
        "needs_water",
        "needs_sunlight",
        "disease",
        "unknown"
      ],
      "description": "\u05de\u05e6\u05d1 \u05d1\u05e8\u05d9\u05d0\u05d5\u05ea"
    },
    "analysis": {
      "type": "string",
      "description": "\u05e0\u05d9\u05ea\u05d5\u05d7 \u05de\u05e6\u05d1 \u05d4\u05e6\u05de\u05d7"
    },
    "recommendations": {
      "type": "string",
      "description": "\u05d4\u05de\u05dc\u05e6\u05d5\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc"
    },
    "photo_url": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05d4 \u05e9\u05e6\u05d5\u05dc\u05de\u05d4 \u05d1\u05e0\u05d9\u05ea\u05d5\u05d7"
    }
  },
  "required": [
    "plant_id",
    "date",
    "health_status"
  ]
}