{
  "name": "IncomeEntry",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05de\u05e9\u05de\u05e8\u05ea"
    },
    "shift_type": {
      "type": "string",
      "enum": [
        "morning",
        "afternoon",
        "evening"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05de\u05e9\u05de\u05e8\u05ea"
    },
    "hours_worked": {
      "type": "number",
      "description": "\u05e9\u05e2\u05d5\u05ea \u05e2\u05d1\u05d5\u05d3\u05d4"
    },
    "hourly_rate": {
      "type": "number",
      "description": "\u05e9\u05db\u05e8 \u05dc\u05e9\u05e2\u05d4"
    },
    "total_earned": {
      "type": "number",
      "description": "\u05e1\u05d4\u05f4\u05db \u05d4\u05db\u05e0\u05e1\u05d4"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "date",
    "shift_type",
    "hours_worked"
  ]
}