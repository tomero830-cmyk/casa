      "description": "\u05ea\u05d5\u05db\u05df / \u05e4\u05e8\u05d8\u05d9 \u05d4\u05d0\u05d9\u05de\u05d5\u05df"
    },
    "is_completed": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d0\u05d9\u05de\u05d5\u05df \u05d1\u05d5\u05e6\u05e2"
    },
