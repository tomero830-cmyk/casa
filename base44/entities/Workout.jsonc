    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d0\u05d9\u05de\u05d5\u05df"
    },
    "workout_type": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d0\u05d9\u05de\u05d5\u05df (\u05db\u05d5\u05ea\u05e8\u05ea)"
    },
    "content": {
