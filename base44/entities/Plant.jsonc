{
  "name": "Plant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e6\u05de\u05d7"
    },
    "photo_url": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05e6\u05de\u05d7"
    },
    "location": {
      "type": "string",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05e6\u05de\u05d7 \u05d1\u05d1\u05d9\u05ea"
    },
    "health_status": {
      "type": "string",
      "enum": [
        "healthy",
        "needs_water",
        "needs_sunlight",
        "disease",
        "unknown"
      ],
      "default": "unknown",
      "description": "\u05de\u05e6\u05d1 \u05d1\u05e8\u05d9\u05d0\u05d5\u05ea \u05d4\u05e6\u05de\u05d7"
    },
    "last_watered": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e9\u05e7\u05d9\u05d4 \u05d0\u05d7\u05e8\u05d5\u05df"
    },
    "watering_interval_days": {
      "type": "number",
      "default": 3,
      "description": "\u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05d4\u05e9\u05e7\u05d9\u05d4 \u05d1\u05d9\u05de\u05d9\u05dd"
    },
    "ai_analysis": {
      "type": "string",
      "description": "\u05e0\u05d9\u05ea\u05d5\u05d7 AI \u05d0\u05d7\u05e8\u05d5\u05df"
    },
    "care_recommendations": {
      "type": "string",
      "description": "\u05d4\u05de\u05dc\u05e6\u05d5\u05ea \u05d8\u05d9\u05e4\u05d5\u05dc"
    }
  },
  "required": [
    "name"
  ]
}